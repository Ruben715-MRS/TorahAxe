{
  "name": "torahaxe",
  "version": "1.0.0",
  "description": "TorahAxe — L'application de référence pour la vie juive au quotidien (PWA & iOS Native App)",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./css/tailwind-input.css -o ./css/tailwind.generated.css --minify",
    "build:native": "npm run build:css && node scripts/build.js --native",
    "cap:sync": "npm run build:native && npx cap sync",
    "cap:open:ios": "cap open ios",
    "cap:build:ios": "npm run build:native && npx cap sync ios",
    "build": "npm run build:css && node scripts/build.js",
    "test": "node --test"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "tailwindcss": "^3.4.19"
  }
}
